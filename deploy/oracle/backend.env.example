# Plantilla de /etc/gestion-educativa/backend.env en la VM de Oracle Cloud.
# Copiar al servidor, completar y proteger:  sudo chmod 640, propietario root:ubuntu.
# NUNCA subir el archivo real al repositorio.

NODE_ENV=production
PORT=3000

# 48 bytes aleatorios en hexadecimal (96 caracteres):  openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=24h

# MySQL local de la VM. Usuario limitado (no root); contraseña nueva, no la de XAMPP.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gestion_educativa
DB_USER=gestion_app
DB_PASSWORD=
# MySQL escucha solo en 127.0.0.1 dentro de la misma VM: el tráfico no sale a la red.
DB_SSL=false
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=100
DB_CONNECT_TIMEOUT_MS=10000

# Origen HTTPS exacto del frontend en Vercel (sin barra final). Varios: separados por comas.
CORS_ORIGINS=https://cienciaseingeniaria.vercel.app
# Nginx corre en la misma VM y sobrescribe X-Forwarded-For: solo se confía en loopback.
TRUST_PROXY=loopback

UPLOAD_DIRECTORY=/srv/gestion/uploads
MAX_UPLOAD_BYTES=10485760
READINESS_TIMEOUT_MS=3000
REQUEST_TIMEOUT_MS=120000

ENABLE_DEMO_SEED=false
INSTITUTIONAL_EMAIL_DOMAIN=cienciaseingenieria.edu

# Panel de superadministración (suspensión, respaldos, recuperación aislada).
OPERATIONS_DIRECTORY=/srv/gestion/operations
# true: hay una sola instancia de la API (PM2 con instances: 1).
OPERATIONS_SINGLE_INSTANCE=true
# Opcional, para la recuperación aislada desde el panel:
# RECOVERY_DB_NAME=gestion_recuperacion
# RECOVERY_UPLOAD_DIRECTORY=/srv/gestion/recovery-uploads
