NODE_ENV=development
PORT=3000
JWT_SECRET=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gestion_educativa
DB_USER=
DB_PASSWORD=
DB_SSL=false
# En producción: origen HTTPS exacto del frontend; lista separada por comas.
CORS_ORIGINS=http://localhost:5173
# IP/CIDR de proxies verificados. Vacío no confía en X-Forwarded-For.
TRUST_PROXY=
# Producción: ruta ABSOLUTA del volumen privado montado y escribible.
# UPLOAD_DIRECTORY=/data/uploads
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=100
DB_CONNECT_TIMEOUT_MS=10000
READINESS_TIMEOUT_MS=3000
REQUEST_TIMEOUT_MS=120000
MAX_UPLOAD_BYTES=10485760
ENABLE_DEMO_SEED=false
# Dominio usado como identificador de acceso; no crea buzones de correo.
INSTITUTIONAL_EMAIL_DOMAIN=cienciaseingenieria.edu

# Panel superadministrador: volumen privado persistente, separado de uploads.
# OPERATIONS_DIRECTORY=/data/operations
# true SOLO tras verificar una instancia API y detener jobs/escritores externos.
OPERATIONS_SINGLE_INSTANCE=false
# Recuperación: otra base previamente creada y vacía; usa la misma conexión MySQL.
# RECOVERY_DB_NAME=gestion_recuperacion
# RECOVERY_UPLOAD_DIRECTORY=/data/recovery-uploads
