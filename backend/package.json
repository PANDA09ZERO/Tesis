{
  "name": "gestion-educativa-backend",
  "version": "1.0.0",
  "description": "Backend del Sistema de GestiÃ³n Educativa",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "seed": "tsx scripts/seed.ts",
    "migrate:payments": "npm run build && node scripts/migrate-payments.cjs",
    "test:payments": "npm run build && node --test tests/payments.test.cjs",
    "test:payments:db": "npm run build && node --test tests/payments.integration.test.cjs",
    "test:profesores": "npm run build && node --test tests/profesores.test.cjs tests/profesores.integration.test.cjs",
    "test:estudiantes": "npm run build && node --test tests/estudiantes.test.cjs tests/estudiantes.integration.test.cjs",
    "test:integral": "npm run build && node tests/integral.test.cjs && node tests/integral.integration.test.cjs",
    "test:sin-ia": "npm run build && node tests/ai-removal.test.cjs",
    "db:install": "node scripts/database.cjs install",
    "db:check": "node scripts/database.cjs check",
    "db:baseline": "node scripts/database.cjs baseline",
    "production:check": "node scripts/database.cjs preflight",
    "admin:bootstrap": "node scripts/bootstrap-admin.cjs",
    "test:production": "npm run build && node tests/production.test.cjs && node tests/production.integration.test.cjs",
    "test:all": "npm run build && node scripts/test-all.cjs",
    "backup:create": "node scripts/backup.cjs create",
    "backup:restore": "node scripts/backup.cjs restore",
    "migrate:production": "node scripts/migrate-production.cjs",
    "test:familia": "npm run build && node tests/familia.test.cjs && node tests/integral.integration.test.cjs",
    "superadmin:bootstrap": "npm run build && node scripts/bootstrap-superadmin.cjs",
    "test:superadmin": "npm run build && node tests/private-prompt.test.cjs && node tests/superadmin.integration.test.cjs",
    "test:credentials": "npm run build && node --test tests/credentials.test.cjs",
    "test:asignaciones": "npm run build && node tests/asignaciones.integration.test.cjs",
    "academic:diagnose": "npm run build && node scripts/diagnose-academic-assignments.cjs",
    "migrate:libretas": "npm run build && node scripts/migrate-report-rules.cjs",
    "test:libretas": "npm run build && node --test tests/libreta-rules.test.cjs",
    "migrate:incidencias": "npm run build && node scripts/migrate-incidencias.cjs",
    "test:incidencias": "npm run build && node --test tests/incidencias.test.cjs",
    "test:alertas": "npm run build && node --test tests/alertas-reglas.test.cjs",
    "migrate:historicos": "npm run build && node scripts/migrate-historicos.cjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.0",
    "saxes": "^6.0.0",
    "tar": "^7.5.22",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.5",
    "@types/cors": "^2.8.15",
    "@types/express": "^4.17.18",
    "@types/jsonwebtoken": "^9.0.4",
    "@types/morgan": "^1.9.7",
    "@types/multer": "^1.4.9",
    "@types/node": "^24.19.2",
    "@types/yauzl": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.2.2"
  }
}
